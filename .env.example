# Copy to .env if you need overrides. Defaults keep everything on loopback.
# No API keys. Do not add cloud provider tokens in v1.

# Web
WEB_HOST=127.0.0.1
WEB_PORT=3010
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3010,http://localhost:3010

# Ollama (local only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ephemeral session TTL (seconds)
SESSION_TTL_SECONDS=900
